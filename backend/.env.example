# =============================================================================
# Unihood backend - environment template.
#
# Copy to `backend/.env` and fill in. `.env` is git-ignored; this template is
# the documentation. Every value here is SERVER-ONLY: nothing in this file is
# ever shipped to the mobile app. The app reads exactly one variable,
# `EXPO_PUBLIC_API_BASE_URL`, from the repository-root `.env`.
#
# The server refuses to start when a required value is missing or malformed and
# prints which one, so a misconfiguration is never a silent runtime failure.
# =============================================================================

# development | production. `production` forces EXPOSE_DEV_TOKENS off.
NODE_ENV=development

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
# 0.0.0.0 listens on every interface, which is what a physical test phone needs.
API_HOST=0.0.0.0
API_PORT=4000

# The address the API can be reached at, used to build the links inside emails.
# * Emulator on the same machine -> http://localhost:4000
# * Physical phone             -> http://<computer LAN IP>:4000  (see README)
API_PUBLIC_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# MySQL
#
# Use the dedicated, least-privileged account - not `root`. It only needs DML
# plus the DDL rights the migration runner uses, on `unihood.*` alone.
# -----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unihood
DB_USER=unihood_app
DB_PASSWORD=replace-me
DB_CONNECTION_LIMIT=10

# -----------------------------------------------------------------------------
# Tokens
#
# JWT_ACCESS_SECRET must be a long random string: generate one with
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Refresh sessions are opaque random tokens stored only as SHA-256 hashes, so
# they stay revocable and are useless if the database is read.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-64-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MAX_ACTIVE_REFRESH_SESSIONS=10
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# -----------------------------------------------------------------------------
# Rate limiting
#
# Every bucket below is counted per client IP - except the group-chat write,
# which is counted per *member* (src/middleware/messageLimit.ts). Both chat
# transports, POST /api/groups/:id/messages and the socket's `message:send`,
# spend that one allowance, so switching transport buys nothing.
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=400
# Stricter bucket applied to register / login / refresh / password recovery.
AUTH_RATE_LIMIT_MAX_REQUESTS=40
# The chat's own, tighter ceiling because a write is worth more than a read: 300
# writes per 15 minutes is about twenty posts a minute, far past anyone typing,
# and it is reached only by a client in a loop.
MESSAGE_RATE_LIMIT_MAX_REQUESTS=300
# The window that ceiling is measured over - its own value, so a chatty endpoint
# can be tuned without touching the per-IP buckets. The counters live in the
# running process only: a restart forgets them, and two instances would each
# enforce their own (see README -> "Group chat" -> Limitations).
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Email delivery
#
# Local development needs NO provider, NO credentials and NO paid service: with
# `log` (the default) messages are written to backend/.mail-outbox/ and the
# single-use link is returned to a development client, so the whole flow is
# testable without a mailbox. Leave the SMTP_* values blank - they exist only for
# a later deployment, where `smtp` requires them (and stops the server at startup
# if they are missing, rather than pretending an email was sent).
#
# The email endpoints are no longer part of the sign-in flow (Phase 5 replaced
# them with a phone number and a one-time code). They stay mounted for accounts
# created before that change; see README -> "Phone sign-in".
# -----------------------------------------------------------------------------
MAIL_TRANSPORT=log
MAIL_FROM=Unihood <no-reply@unihood.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Phone sign-in (Phase 5)
#
# `log` needs no provider and no credentials: the code is written to
# backend/.otp-outbox/ (git-ignored) and the API says `delivered: false`, because
# nothing was delivered. Production REFUSES to start with `log`, so a shipped
# build can never be configured to "send" codes into a file.
#
# `sms` posts { to, message, code } as JSON to SMS_PROVIDER_URL with an optional
# bearer token, and reports `delivered: true` only when the provider accepts it.
# The server refuses to start with `sms` and no SMS_PROVIDER_URL.
# -----------------------------------------------------------------------------
OTP_TRANSPORT=log
OTP_CODE_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_RATE_LIMIT_MAX_REQUESTS=30
# Required in production. When blank, development falls back to JWT_ACCESS_SECRET.
OTP_HASH_SECRET=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER=Unihood

# Development convenience only, and ignored when NODE_ENV=production: include
# the single-use verification / reset link in the API response while the mail
# transport is `log`, so a local client can finish a flow no mailbox can.
#
# There is deliberately no equivalent for one-time codes. A code is never
# returned in a response - it is read from backend/.otp-outbox/ instead, which is
# the directory the enabled development transport writes to.
EXPOSE_DEV_TOKENS=true

# -----------------------------------------------------------------------------
# CORS
#
# Comma-separated origins, or `*`. Only browsers enforce this; the mobile app
# does not. Keep `*` for local development.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*

# Schemes a post-verification redirect is allowed to use. This is what keeps the
# email links from becoming an open redirect if a crafted `redirectTo` ever
# reaches the API. The Expo Go scheme is `exp`.
ALLOWED_REDIRECT_SCHEMES=unihood,exp
