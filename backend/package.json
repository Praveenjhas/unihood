{
  "name": "unihood-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Unihood API - authentication, profiles, interests and location-based people discovery on MySQL.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "smoke": "tsx src/tools/smoke.ts",
    "smoke:clean": "tsx src/tools/smoke.ts --clean",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/migrate.ts --status",
    "db:check": "tsx src/db/check.ts",
    "db:backup": "tsx src/tools/resetData.ts --backup",
    "db:reset:dry": "tsx src/tools/resetData.ts --dry",
    "db:reset": "tsx src/tools/resetData.ts --apply",
    "db:restore": "tsx src/tools/resetData.ts --restore --yes",
    "phone:link": "tsx src/tools/linkPhone.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
