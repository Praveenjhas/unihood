# Unihood — environment template.
#
# Copy to `.env` (git-ignored: `.env`, `.env.local`, `.env.*.local`) and fill in.
# Expo inlines every `EXPO_PUBLIC_*` variable into the JS bundle at build time, so
# it must be read as a static property access (`process.env.EXPO_PUBLIC_X`) and:
#   * never put a server-only secret here — anything with this prefix is public;
#   * after changing a value, restart the dev server to pick it up.
#
# The app reads accounts, profiles, interests, locations and nearby discovery from
# the Unihood API in `backend/`. If the URL below is empty the app starts in an
# explicit "configuration required" state — it never falls back to fake sign-in or
# mock people.

# Which environment the app is running against: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Base URL of the Unihood API, without a trailing slash.
#   * iOS simulator / Android emulator / web: http://localhost:4000
#   * a physical phone: the LAN address of the machine running the backend, for
#     example http://192.168.0.5:4000 — "localhost" would be the phone itself.
# The backend prints the address it listens on when it starts, and `npm run dev`
# in `backend/` serves it on port 4000 (see backend/.env -> API_PORT).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.9:4000
